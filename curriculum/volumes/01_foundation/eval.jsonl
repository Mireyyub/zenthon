{"question":"Mövcud olan hər şey necə adlanır?","answer":"Varlıq."}
{"question":"Obyekt nədir?","answer":"Xüsusiyyətləri olan varlıq."}
{"question":"Xüsusiyyət nədir?","answer":"Obyekti təsvir edən məlumat."}
{"question":"Planet obyektdirmi?","answer":"Bəli."}
{"question":"Kvadrat dairə mövcuddurmu?","answer":"Xeyr."}
{"question":"İnsan hansı kateqoriyaya daxildir?","answer":"Məməli."}
{"question":"Qartal hansı kateqoriyaya daxildir?","answer":"Quş."}
{"question":"Ay nə ətrafında fırlanır?","answer":"Yer."}
{"question":"Yer nə ətrafında fırlanır?","answer":"Günəş."}
{"question":"Daş məməlidirmi?","answer":"Xeyr."}
